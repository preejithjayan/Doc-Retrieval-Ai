DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/doc_retrieval
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
CHROMA_DIR=/app/chroma
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LLM_FALLBACK_MODEL=google/flan-t5-base
HUGGINGFACE_API_TOKEN=replace-with-your-huggingface-token
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=no-reply@docai.local
